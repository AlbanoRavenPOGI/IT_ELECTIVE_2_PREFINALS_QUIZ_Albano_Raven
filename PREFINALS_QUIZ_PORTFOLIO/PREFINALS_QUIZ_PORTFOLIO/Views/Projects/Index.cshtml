@model IEnumerable<PREFINALS_QUIZ_PORTFOLIO.Models.Project>
@{
    ViewData["Title"] = "Dashboard — Table of Contents";
    Layout = "_Layout";
}

<style>
    .top-navbar {
        background: rgba(15, 23, 42, 0.7);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--glass-border);
        padding: 16px 0;
        margin-bottom: 30px;
    }

    .project-card {
        transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

        .project-card:hover {
            transform: translateY(-8px);
            border-color: rgba(167, 139, 250, 0.4);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(139, 92, 246, 0.2);
        }

    .card-img-wrapper {
        position: relative;
        height: 190px;
        overflow: hidden;
    }

        .card-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

    .project-card:hover .card-img-wrapper img {
        transform: scale(1.06);
    }

    .category-badge {
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.8), rgba(236, 72, 153, 0.8));
        color: #ffffff;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 20px;
        backdrop-filter: blur(4px);
    }

    .btn-detail {
        background: rgba(255, 255, 255, 0.1);
        color: #ffffff;
        border: 1px solid var(--glass-border);
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 8px 16px;
        transition: all 0.25s ease;
    }

        .btn-detail:hover {
            background: var(--accent-purple);
            color: #ffffff;
            border-color: var(--accent-purple);
        }

    .btn-github {
        background: rgba(15, 23, 42, 0.6);
        color: #cbd5e1;
        border: 1px solid var(--glass-border);
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 8px 14px;
        transition: all 0.25s ease;
    }

        .btn-github:hover {
            background: #ffffff;
            color: #0f172a;
        }
</style>

<header class="top-navbar">
    <div class="container d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold fs-5" style="width:42px; height:42px; background: linear-gradient(135deg, #8b5cf6, #ec4899);">
                R
            </div>
            <div>
                <h6 class="mb-0 fw-bold text-white">Raven Joe R. Albaño</h6>
                <small class="text-secondary">BSIT Portfolio Dashboard</small>
            </div>
        </div>
        <div>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-semibold">
                <i class="bi bi-box-arrow-right me-1"></i> Logout
            </a>
        </div>
    </div>
</header>

<div class="container pb-5">
    <div class="row align-items-end mb-4">
        <div class="col-md-8">
            <span class="badge bg-purple bg-opacity-25 text-purple border border-purple px-3 py-2 rounded-pill small mb-2" style="color: #c084fc; border-color: #a855f7 !important;">
                <i class="bi bi-folder2-open me-1"></i> Table of Contents
            </span>
            <h1 class="fw-extrabold display-6 text-white mb-2">My Portfolio - Prefinals Quiz</h1>
            <p class="text-secondary mb-0">Github Repositories</p>
        </div>
        <div class="col-md-4 text-md-end mt-3 mt-md-0">
            <span class="text-light small fw-medium bg-dark bg-opacity-50 px-3 py-2 rounded-pill border border-secondary">
                Total Projects: <strong class="gradient-text">@Model.Count()</strong>
            </span>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var proj in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="glass-card project-card">
                    <div class="card-img-wrapper">
                        <img src="@proj.ThumbnailUrl" alt="@proj.Title" onerror="this.src='https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=600&auto=format&fit=crop'" />
                        <div class="position-absolute top-0 start-0 m-3">
                            <span class="category-badge">@proj.Category</span>
                        </div>
                    </div>

                    <div class="p-4 d-flex flex-column flex-grow-1">
                        <h5 class="fw-bold text-white mb-2 text-truncate" title="@proj.Title">@proj.Title</h5>
                        <p class="text-secondary small flex-grow-1 mb-4" style="line-height: 1.6; color: #cbd5e1 !important;">
                            @proj.Description
                        </p>

                        <div class="d-flex align-items-center gap-2 mt-auto pt-3 border-top border-secondary border-opacity-25">
                            <a asp-action="Details" asp-route-id="@proj.Id" class="btn btn-detail flex-grow-1 text-center">
                                View Details <i class="bi bi-arrow-right short ms-1"></i>
                            </a>
                            <a href="@proj.GithubUrl" target="_blank" class="btn btn-github" title="View on GitHub">
                                <i class="bi bi-github"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>